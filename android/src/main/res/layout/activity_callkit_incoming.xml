<?xml version="1.0" encoding="utf-8"?>
<!-- Incoming call screen modeled on the iPhone one: who calls at the top, decline (red) and accept (green) at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_screen"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/call_screen_side_padding"
    android:paddingTop="@dimen/call_screen_top_padding"
    android:paddingEnd="@dimen/call_screen_side_padding"
    android:paddingBottom="@dimen/call_screen_bottom_padding">

    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/call_secondary_text"
        android:textSize="@dimen/size_text_call_detail" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_margin"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:fontFamily="sans-serif-light"
        android:textColor="@android:color/white"
        android:textSize="@dimen/size_text_caller" />

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/base_margin"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/call_secondary_text"
        android:textSize="@dimen/size_text_call_detail" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/llCallActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnDecline"
                android:layout_width="@dimen/call_button"
                android:layout_height="@dimen/call_button"
                android:background="@drawable/bg_call_decline"
                android:padding="@dimen/base_margin_x2"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call_decline" />

            <TextView
                android:id="@+id/tvDecline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_margin"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="@dimen/size_text_call_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnAccept"
                android:layout_width="@dimen/call_button"
                android:layout_height="@dimen/call_button"
                android:background="@drawable/bg_call_accept"
                android:padding="@dimen/base_margin_x2"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call_accept" />

            <TextView
                android:id="@+id/tvAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/base_margin"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="@dimen/size_text_call_button" />
        </LinearLayout>
    </LinearLayout>

    <!-- Custom answer buttons (AndroidParams.customActions); filled at runtime, they replace decline/accept. -->
    <LinearLayout
        android:id="@+id/llCustomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>
